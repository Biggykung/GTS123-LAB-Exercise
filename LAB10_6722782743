# ===== Q1 =====
import numpy as np
size = int(input("Input size of matrix: "))
z = []
for i in range(1,size+1) :
    for j in range(1,size+1) :
        if i <= size and j <= size :
            k = float(input("Input element at row %d column %d: " %(i,j)))  
            z.append(k)
        else :
            print("Error")
print("Output:")
y = np.array(z)
w = np.reshape(y,(size,size))
print("Matrix = ")
print(w)
a = np.linalg.det(w)
print("Determinant = %.1f" %(a))
if a != 0:  
    c = np.linalg.inv(w)
    print("Inverse matrix =")
    print(c)
else:
    print("Matrix is singular, inverse cannot be calculated.")
# ===== Q2 =====
import numpy as np
member = []
xyz = []
for i in range(1,13):
    cn = int(input("Input C%d: " %i))
    if i != 4 and i != 8 and i != 12:
        member.append(cn)
    else:
        xyz.append(cn)
matrix = np.array(member)
xyz = np.array(xyz)
matrix = np.reshape(matrix, (3,3))
if np.linalg.det(matrix) != 0:
    inv = np.linalg.inv(matrix)
else:
    print("Unable to find  solution")
xyz = np.matmul(inv,xyz)
print("Solution")
print("x = %.2f" %xyz[0])
print("y = %.2f" %xyz[1])
print("z = %.2f" %xyz[2])
