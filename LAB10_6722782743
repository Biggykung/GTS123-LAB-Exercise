import numpy as np
data = np.loadtxt('sales - Sheet1.tsv',delimiter='\t',dtype=float)
branch = data[:,0]
sale = data[:,1:]
sumsale = np.sum(sale,axis=1)
sorted_ss = np.sort(sumsale)
argsort_ss = np.argsort(sumsale)
for i in range(data.shape[0]) :
    print("Branch %d --> %.2f" %(branch[argsort_ss[-1-i]], sorted_ss[-1-i]))
