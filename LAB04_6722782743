# ===== Q10 =====
print("Welcome to Income Tax Computation Program")
income = input("Please enter your income (THB): ")
income = float(income)

if  (income >= 0):
    step1 = 35000*5/100
    step2 = 50000*7.5/100

    tax = 0

    if income > 100000:
        tax = ((income - 100000) * 10/100) + step2 + step1
    elif income > 50000:
        tax = ((income - 50000) * 7.5/100) +step1
    elif income > 15000:
        tax = ((income - 15000) * 5/100)
    print("Tax expenxe = %.2f" %(tax))
    print("Your net income after tax = %.2f" % (income-tax))
else:
    print("You are in debt!")
