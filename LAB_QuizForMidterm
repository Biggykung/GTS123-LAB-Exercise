# ===== Q4 =====
n = str(input("Input: "))
if not n.isnumeric():
    print("Error")
else :    
    for x in n :
        if x in "0123456789" :
            if int(x) == 0 :
                print()
            else :
                if int(x) >= 2 and int(x) % 2 == 0 :
                    print("#*"*(int(x)//2))
                elif int(x) >= 3 and int(x) % 2 == 1 :
                    print("#*"*(int(x)//2)+"#")
                else :
                    print("#"*(int(x) % 3))
