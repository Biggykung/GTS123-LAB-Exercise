# ===== Q1 =====
pm,ps= input("Enter your running pace (minutes per kilometer): ").split(":")
pm = int(pm)
ps = int(ps)+(pm*60)
dis_type = input("Enter your distance (a) Mini-marathon, (b) Half-marathon, (c) Full-marathon:")
dis_type = dis_type.upper()
dis = 0
cut = 0
if dis_type == "A" :
    dis = 10 
    cut = 2.5
elif dis_type == "B" :
    dis = 21.0975
    cut = 6.0
elif dis_type == "C" :
    dis = 42.195
    cut = 6.0        
if dis > 0:
    rundis = ps * dis
    esthour = rundis//(60**2)
    estain = (rundis%(60**2))//60
    print("Your estimated finish time is %d hours %d minutes" %(esthour,estain))
    word = "cannot"
    if rundis <= (cut*60*60) :
        word = "can"
    print("You %s finish in cutoff time (Your cutoff time is %.2f hours)." %(word,cut))
else :
    print("Invalid distance selection")
