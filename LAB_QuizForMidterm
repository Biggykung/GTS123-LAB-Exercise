x = input("Input: ").upper()
if len(x) == 3 :
    v = True
    for c in x :
        if not (c== "A" or c == "B" or c == "I" or c == "O" or c == "U"):
            v = False

    if v :
        for i in x:
            for j in x:
                for k in x:
                    if not (i == j or j == k or k == i):
                        print("%s%s%s" %(i,j,k))
