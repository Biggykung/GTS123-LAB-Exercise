# ===== Q10 =====
while True:
    x = input("Enter an integer number ('X' to exit): ") 
    if x == "x" or x == "X":
        break
    if x.isdigit(): 
        x = int(x)
    else:
        continue
    for i in range (x):
        for j in range(x):
            if i == j or i + j == x - 1: 
                print("X", end = " ")
            else:
                print(".", end = " ")
        print("")
