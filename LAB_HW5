k = []  
m = []  
o = []  
z = []  
while True:
    p = input("Enter a line (or 'END' to finish): ")
    if p.lower() == "end":
        break
    else:
        words = p.split()
        for word in words:
           
            word = word.lower().strip(",.")
            z.append(word)
for word in set(z):  
    count = z.count(word)
    if count == 1 or count == 2:
        k.append(word)
    elif count == 3 or count == 4:
        m.append(word)
    elif count > 4:
        o.append(word)
print("1. Number of words that appear once or twice:", len(k))
print("2. Number of words that appear three and four times:", len(m))
print("3. Number of words that appear more than four times:", len(o))
