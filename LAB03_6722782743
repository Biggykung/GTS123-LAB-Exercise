# ===== Q9 =====
import math
w1 = input("Enter the width of the cube:")
w2 = input("Enter the width of the container:")
h = input("Enter the height of the container:")
d = input("Enter the depth of the container:")
w1,w2,h,d = float(w1),float(w2),float(h),float(d)
cube_w = math.floor(w2/w1)
cube_h = math.floor(h/w1)
cube_d = math.floor(d/w1)
number = cube_w*cube_h*cube_d
print("The number of cubes that can fit into the container is %d" %number)
