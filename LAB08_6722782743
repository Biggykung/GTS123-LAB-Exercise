# ===== Q1 =====
s = input("Input: ")
words = s.lower().split()
f = {}
for word in words:
    f[word] = f.get(word, 0) + 1
max_f = max(f.values())
most_frequent_words = {word: count for word, count in f.items() if count == max_f}
print("Output: ")
for word, count in most_frequent_words.items():
    print("%s = %s" %(word,count))
# ===== Q2 =====
inp = input("Input: ").split()
count = {}
for num in inp:
    if num.isnumeric():  
        num = int(num) 
        if num in count:
            count[num] += 1 
        else:
            count[num] = 1 
is_good = True
for num, o in count.items():
    if o != num:  
        is_good = False
        break
if is_good == True:
    print("good sequence")
else:
    print("not good sequence")
