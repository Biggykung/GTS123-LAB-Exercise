# ===== Q4 =====
from operator import itemgetter
x = ""
d = {}
while x != "DONE" :
    x = input("Input (DONE = exit): ")
    if x != "DONE" :
        try :
            a,b = x.split()
            if not a.isnumeric() :
                print("Invalid input")
            elif a in d:
                print("Duplicated ID")
            else :
                d[a] = int(b)
        except:
            print("Invalid input")
print("Output: ")
k = sorted(d.items(),key=itemgetter(1),reverse=True)
k = dict(k)
for i,v in k.items():
    print(i,v)
