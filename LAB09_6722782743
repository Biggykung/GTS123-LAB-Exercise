def LeftRotate(x,n):
    return x[n:] + x[:n]
def RightRotate(x,n):
    size = len(x)
    return x[size-n:] + x[:size-n]
x = input("Enter 5 inputs: ")
x = x.split()
if len(x) == 5:
    n = input("Enter an integer number of rotations (0-4): ")
    try:
        n = int(n)
    except:
        n = -1
else:
    n = -1
if n >= 0 and n <= 4:
    print("The left-rotated list: ",LeftRotate(x,n))
    print("The right-rotated list: ",RightRotate(x,n))
    print("The right-rotated list: ",LeftRotate(x[::-1],n)[::-1])
else:
    print("Error!")
