from math import pi
def myCylinder(r, h):
    V = pi * (r ** 2) * h
    A = (2 * pi * r * h) + (2 * pi * (r ** 2))
    return V, A
radius = float(input("Enter the radius r of the cylinder: "))
height = float(input("Enter the height h of the cylinder: "))
volume, area = myCylinder(radius, height)  
print("The volume is %.2f and the surface area is %.2f" %(volume, area))
