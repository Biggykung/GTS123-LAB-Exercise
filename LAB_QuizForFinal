# ===== Q4 =====
def main():
    players = {}
    while True:
        inp = input("Input: ").strip()
        if inp.lower() == 'done':
            if not players:
                print("No players")
                break
            else:
                total_score = sum(players.values())
                avg_score = total_score / len(players)
                sorted_players = sorted(players.items(), key=lambda x: x[1], reverse=True)
                for i, (name, score) in enumerate(sorted_players):
                    if i == 0:
                        print(f"{name}\t{score}\tGold")
                    elif score > avg_score:
                        print(f"{name}\t{score}\tSilver")
                    else:
                        print(f"{name}\t{score}")
                break
        else:
            parts = inp.split()
            if len(parts) != 2:
                print("Invalid input")
                continue
            name, score_str = parts
            try:
                score = int(score_str)
                if score < 0:
                    print("Invalid input")
                    continue
                if name in players:
                    print("Duplicated player")
                else:
                    players[name] = score
            except ValueError:
                print("Invalid input")
if __name__ == "__main__":
    main()
