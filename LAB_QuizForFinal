from operator import itemgetter
def report(a):
    print("List:")
    if len(a) > 0:
        b = sorted(a.items(), key=itemgetter(1), reverse=True)
        for r in b:
            print("%-10s %3.0f" % (r[0], r[1]))
    else:
        print("> empty list!")
