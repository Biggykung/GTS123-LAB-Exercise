b = float(input("Enter the initial balance:"))
x= ""
while True:
    x = input("Transaction type and amount (\"done 0\" to exit):")
    if x == "done 0":
        print("> Current balance = %.0f THB" %b)
        break
    try: 
        t, v = x.split()
        v = float(v)
    except: 
        print("> Invalid transaction!")
        continue 
    if v <= 0:
        print("> Invalid transaction!") 
        continue
    if t == 'D':
        b += v
        print("Deposit = %.0f THB, current balance = %.0f THB"%(v,b))
    elif t == 'W':
        if v <= b:
            b -= v
            print("> Withdrawal = %.0f THB, current balance = %.0f THB" %(v,b))
        else:
            print("> Invalid transaction!")
            continue
    else: 
        print("> Invalid transaction!")
